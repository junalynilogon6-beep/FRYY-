local function addText(parent, text, y, height)
    local label = Instance.new("TextLabel")
    label.Position = UDim2.fromOffset(3, y)
    label.Size = UDim2.new(1, -6, 0, height or 30)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = WHITE
    label.TextSize = 14
    label.Font = Enum.Font.GothamMedium
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = parent
    return label
end

local function animateButton(button)
    button.Activated:Connect(function()
        local original = button.Size
        TweenService:Create(button, TweenInfo.new(0.08), {
            Size = UDim2.new(
                original.X.Scale, original.X.Offset - 3,
                original.Y.Scale, original.Y.Offset - 2
            )
        }):Play()
        task.delay(0.09, function()
            if button.Parent then
                TweenService:Create(button, TweenInfo.new(0.1), {
                    Size = original
                }):Play()
            end
        end)
    end)
end

