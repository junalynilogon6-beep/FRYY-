local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local old = playerGui:FindFirstChild("FRYYHubV5")
if old then old:Destroy() end

local BLUE = Color3.fromRGB(0, 190, 255)
local DARK = Color3.fromRGB(8, 15, 30)
local PANEL = Color3.fromRGB(15, 27, 48)
local WHITE = Color3.fromRGB(230, 245, 255)

local gui = Instance.new("ScreenGui")
gui.Name = "FRYYHubV5"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.Parent = playerGui

local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = obj
end

local function stroke(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = thickness or 1
    s.Transparency = 0.15
    s.Parent = obj
end

local function makeButton(parent, label, position, size)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = position
    b.BackgroundColor3 = PANEL
    b.Text = label
    b.TextColor3 = WHITE
    b.TextSize = 14
    b.Font = Enum.Font.GothamSemibold
    b.AutoButtonColor = false
    b.Parent = parent
    corner(b, 9)
    stroke(b, BLUE, 1)
    return b
end

local function notify(message)
    local toast = Instance.new("TextLabel")
    toast.Size = UDim2.new(1, -20, 0, 38)
    toast.Position = UDim2.new(0, 10, 0, 8)
    toast.BackgroundColor3 = PANEL
    toast.BackgroundTransparency = 0.05
    toast.Text = "  ⚡  " .. message
    toast.TextColor3 = WHITE
    toast.TextSize = 13
    toast.Font = Enum.Font.GothamMedium
    toast.TextXAlignment = Enum.TextXAlignment.Left
    toast.ZIndex = 10
    toast.Parent = gui
    corner(toast, 10)
    stroke(toast, BLUE, 1)

    toast.Position = UDim2.new(0, 10, 0, -45)
    TweenService:Create(toast, TweenInfo.new(0.25), {
        Position = UDim2.new(0, 10, 0, 8)
    }):Play()

    task.delay(2, function()
        if toast.Parent then
            local t = TweenService:Create(toast, TweenInfo.new(0.2), {
                BackgroundTransparency = 1,
                TextTransparency = 1
            })
            t:Play()
            t.Completed:Wait()
            toast:Destroy()
        end
    end)
end

